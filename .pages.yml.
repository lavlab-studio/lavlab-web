
media:
  input: media
  output: /media
  rename: safe
  categories: [image]

content:
  - name: proyectos
    label: Proyectos LavLab
    type: file
    path: data/projects.json
    format: json
    list: true
    fields:
      - name: title
        label: Nombre del proyecto
        type: string
        required: true
      - name: category
        label: Categoría
        type: string
      - name: description
        label: Descripción
        type: text
      - name: image
        label: Portada del proyecto
        type: image
      - name: url
        label: Enlace para escuchar o ver (https://...)
        type: string
      - name: published
        label: Visible en la web
        type: boolean
